# RougeChain API endpoint. Defaults to testnet if unset.
# Mainnet:  https://api.rougechain.io/api
# Testnet:  https://testnet.rougechain.io/api
# Local:    http://127.0.0.1:5101/api
VITE_ROUGE_API=https://testnet.rougechain.io/api

# Optional network label shown in the UI.
VITE_ROUGE_NETWORK=testnet

# --- Media storage (IPFS) ---
# Rougee-gram stores photos on IPFS so they are content-addressed and can't be
# quietly removed. Provide a Pinata JWT to enable IPFS uploads. Without one, the
# app falls back to a local (in-browser IndexedDB) store — great for dev, but
# photos then live only on your machine.
#
# Get a free JWT at https://app.pinata.cloud (API Keys -> New Key).
# You can also paste this at runtime in Settings instead of using this file.
VITE_PINATA_JWT=

# Public IPFS gateway used to *read* images (any gateway works).
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# --- Media storage (Cloudflare R2, recommended for video/reels) ---
# Deploy the Worker in workers/media (see CLOUDFLARE.md), then set its URL here
# (or paste it at runtime in Settings). Takes priority over IPFS when set.
VITE_CF_WORKER_URL=
# Only if your Worker enforces an UPLOAD_SECRET (optional anti-spam).
VITE_CF_UPLOAD_SECRET=
# Route video through Cloudflare Stream (adaptive HLS). Requires Stream secrets
# on the Worker (see CLOUDFLARE.md). "true" to enable; also toggleable in Settings.
VITE_CF_STREAM=

# --- RouGee Workers ---
# Verification Worker (issues verified-badge attestations). See workers/verify.
VITE_VERIFY_WORKER_URL=
# Tips-ledger Worker (per-post tip totals). Deploy workers/tips, then set its URL
# here. Without it, posts simply show no tip totals (feature is a no-op).
VITE_TIPS_WORKER_URL=
