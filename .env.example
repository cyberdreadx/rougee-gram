# RougeChain API endpoint. Defaults to testnet if unset.
# Mainnet:  https://api.rougechain.io/api
# Testnet:  https://testnet.rougechain.io/api
# Local:    http://127.0.0.1:5101/api
VITE_ROUGE_API=https://testnet.rougechain.io/api

# Optional network label shown in the UI.
VITE_ROUGE_NETWORK=testnet

# --- Media storage (IPFS) ---
# Rougee-gram stores photos on IPFS so they are content-addressed and can't be
# quietly removed. Provide a Pinata JWT to enable IPFS uploads. Without one, the
# app falls back to a local (in-browser IndexedDB) store — great for dev, but
# photos then live only on your machine.
#
# Get a free JWT at https://app.pinata.cloud (API Keys -> New Key).
# You can also paste this at runtime in Settings instead of using this file.
VITE_PINATA_JWT=

# Public IPFS gateway used to *read* images (any gateway works).
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
